uuu_version 1.4.149
FB: ucmd setenv fastboot_buffer ${loadaddr}
FB: download -f _Image
FB: ucmd setenv fastboot_buffer ${fdt_addr}
FB: download -f _board.dtb
FB: ucmd setenv fastboot_buffer 0x96000000
FB: download -f _initrd
FB: ucmd setenv bootargs console=ttyLP0,115200 root=/dev/mmcblk0p2 rootwait rw quiet loglevel=3 systemd.show_status=0 nokaslr cpuidle.off=1 
FB: acmd booti ${loadaddr} 0x96000000:1a808a ${fdt_addr}
FB: done
